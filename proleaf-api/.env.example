# Copy to .env for local development. Nothing here is a real secret.
PROLEAF_ENV=dev
PROLEAF_HTTP_ADDR=:8080
PROLEAF_DATABASE_URL=postgres://proleaf:proleaf@localhost:5432/proleaf?sslmode=disable

# Required outside dev; at least 32 bytes each. In dev, an ephemeral value is
# generated per process and every token dies with the restart.
PROLEAF_TOKEN_SECRET=dev-token-secret-change-me-0000000000
PROLEAF_OTP_PEPPER=dev-otp-pepper-change-me-00000000000
PROLEAF_ENROLLMENT_CODE_PEPPER=dev-code-pepper-change-me-0000000000

PROLEAF_TOKEN_TTL=12h
PROLEAF_OTP_TTL=5m
PROLEAF_OTP_MAX_ATTEMPTS=5
PROLEAF_OTP_RESEND_INTERVAL=60s
PROLEAF_ENROLLMENT_CODE_TTL=336h

# The consent policy currently in force. Bumping it invalidates every existing
# consent, which is the point: new terms need a new act of consent.
PROLEAF_POLICY_VERSION=2026-01-01

# Classes smaller than this publish no aggregates.
PROLEAF_STATS_MIN_COHORT=5

# log (dev only) | aliyun (not implemented in the skeleton)
PROLEAF_SMS_PROVIDER=log
